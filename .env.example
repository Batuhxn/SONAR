# Compose reads this file after copying to .env. No secrets are required by A1.
# Loopback is the default host binding. IT must choose its own ports and proxy.
SONAR_HOST_PORT=8000
SONAR_ALLOWED_HOSTS=localhost,127.0.0.1
SONAR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set true behind your IT-managed HTTPS reverse proxy.
SONAR_SECURE_COOKIE=false
SONAR_MAX_UPLOAD_MB=8
SONAR_SESSION_TTL_SECONDS=7200
SONAR_MAX_SESSIONS=100
